# ====================================================================
# EduDocente-Studio: Configuración de Entorno y Credenciales OAuth 2.0
# ====================================================================

# --------------------------------------------------------------------
# 1. Configuración de Autenticación OAuth 2.0 (Google, GitHub, Microsoft)
# --------------------------------------------------------------------
# Google Cloud Console (Google Workspace for Education / Google Classroom):
# Redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App:
# Redirect URI: http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Azure Portal (Entra ID / Microsoft 365 Education):
# Redirect URI: http://localhost:8080/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --------------------------------------------------------------------
# 2. Claves de API de Inteligencia Artificial (Opcionales)
# Si se omiten, el sistema activa automáticamente el 'Smart Synthesizer' local.
# --------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# --------------------------------------------------------------------
# 3. Configuración del Servidor Web
# --------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
